{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuizMLYaml Quiz Schema",
  "description": "Schema for quizml YAML files.",
  "type": "array",
  "definitions": {
    "header": {
      "type": "object",
      "properties": {
        "author": { "type": ["string", "null"] },
        "date": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "examtime": { "type": ["string", "null"] },
        "examdate": { "type": ["string", "null"] },
        "examyear": { "type": ["string", "null"] },
        "examvenue": { "type": ["string", "null"] },
        "examsemester": { "type": ["string", "null"] },
        "programmeyear": { "type": ["string", "null"] },
        "modulename": { "type": ["string", "null"] },
        "modulecode": { "type": ["string", "null"] },
        "examiner": { "type": ["string", "null"] },
        "instructions": { "type": ["string", "null"] },
        "materials": { "type": ["string", "null"] },
        "additionalinformation": { "type": ["string", "null"] },
        "_latexpreamble": { "type": ["string", "null"] },
        "_quizml": { "type": ["string", "null"] },
        "_schema": { "type": ["string", "null"] },
        "_config": { "type": ["string", "null"] },
        "_targets": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } },
            { "type": "null" }
          ]
        },
        "_figures_path": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": true
    },
    "markdown": {
      "type": "string",
      "format": "markdown"
    }
  },
  "items": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "description": "The type of the question or part.",
        "enum": [
          "mc",
          "ma",
          "tf",
          "essay",
          "matching",
          "ordering",
          "fill",
          "mfill",
          "num",
          "part"
        ]
      }
    },
    "required": ["type"],
    "allOf": [
      {
        "if": { "properties": { "type": { "const": "ma" } } },
        "then": {
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string" },
            "title": { "type": "string" },
            "marks": { "type": "number", "default": "2.5" },
            "comments": { "$ref": "#/definitions/markdown" },
            "feedback": { "$ref": "#/definitions/markdown" },
            "cols": { "type": "integer", "default": "1" },
            "question": { "$ref": "#/definitions/markdown" },
            "figure": { "$ref": "#/definitions/markdown" },
            "figure-split": { "type": "number" },
            "choices": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "x": { "$ref": "#/definitions/markdown" },
                  "o": { "$ref": "#/definitions/markdown" }
                },
                "additionalProperties": false
              }
            }
          },
          "required": ["question", "choices"],
          "additionalProperties": false
        }
      },
      {
        "if": { "properties": { "type": { "const": "mc" } } },
        "then": {
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string" },
            "title": { "type": "string" },
            "marks": { "type": "number", "default": "2.5" },
            "comments": { "$ref": "#/definitions/markdown" },
            "feedback": { "$ref": "#/definitions/markdown" },
            "cols": { "type": "integer", "default": "1" },
            "question": { "$ref": "#/definitions/markdown" },
            "figure": { "$ref": "#/definitions/markdown" },
            "figure-split": { "type": "number" },
            "choices": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "x": { "$ref": "#/definitions/markdown" },
                  "o": { "$ref": "#/definitions/markdown" }
                },
                "additionalProperties": false
              }
            }
          },
          "required": ["question", "choices"],
          "additionalProperties": false
        }
      },
      {
        "if": { "properties": { "type": { "const": "tf" } } },
        "then": {
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string" },
            "title": { "type": "string" },
            "marks": { "type": "number", "default": "2.5" },
            "comments": { "$ref": "#/definitions/markdown" },
            "feedback": { "$ref": "#/definitions/markdown" },
            "question": { "$ref": "#/definitions/markdown" },
            "figure": { "$ref": "#/definitions/markdown" },

            "figure-split": { "type": "number" },
            "answer": { "type": "boolean" }
          },
          "required": ["question", "answer"],
          "additionalProperties": false
        }
      },
      {
        "if": { "properties": { "type": { "const": "essay" } } },
        "then": {
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string" },
            "title": { "type": "string" },
            "marks": { "type": "number", "default": "4" },
            "comments": { "$ref": "#/definitions/markdown" },
            "feedback": { "$ref": "#/definitions/markdown" },
            "question": { "$ref": "#/definitions/markdown" },
            "answer": { "$ref": "#/definitions/markdown" }
          },
          "required": ["question"],
          "additionalProperties": false
        }
      },
      {
        "if": { "properties": { "type": { "const": "matching" } } },
        "then": {
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string" },
            "title": { "type": "string" },
            "marks": { "type": "number", "default": "2.5" },
            "comments": { "$ref": "#/definitions/markdown" },
            "feedback": { "$ref": "#/definitions/markdown" },
            "question": { "$ref": "#/definitions/markdown" },
            "figure": { "$ref": "#/definitions/markdown" },
            "figure-split": { "type": "number" },
            "choices": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "A": { "$ref": "#/definitions/markdown" },
                  "B": { "$ref": "#/definitions/markdown" }
                },
                "additionalProperties": false,
                "required": ["A", "B"]
              }
            }
          },
          "required": ["question", "choices"],
          "additionalProperties": false
        }
      },
      {
        "if": { "properties": { "type": { "const": "ordering" } } },
        "then": {
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string" },
            "title": { "type": "string" },
            "marks": { "type": "number", "default": "2.5" },
            "comments": { "$ref": "#/definitions/markdown" },
            "feedback": { "$ref": "#/definitions/markdown" },
            "cols": { "type": "integer", "default": "1" },
            "question": { "$ref": "#/definitions/markdown" },
            "figure": { "$ref": "#/definitions/markdown" },
            "figure-split": { "type": "number" },
            "choices": {
              "type": "array",
              "items": { "$ref": "#/definitions/markdown" }
            }
          },
          "required": ["question", "choices"],
          "additionalProperties": false
        }
      },
      {
        "if": { "properties": { "type": { "const": "fill" } } },
        "then": {
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string" },
            "title": { "type": "string" },
            "marks": { "type": "number", "default": "2.5" },
            "comments": { "$ref": "#/definitions/markdown" },
            "feedback": { "$ref": "#/definitions/markdown" },
            "question": { "$ref": "#/definitions/markdown" },
            "figure": { "$ref": "#/definitions/markdown" },
            "figure-split": { "type": "number" },
            "answers": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["question", "answers"],
          "additionalProperties": false
        }
      },
      {
        "if": { "properties": { "type": { "const": "mfill" } } },
        "then": {
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string" },
            "title": { "type": "string" },
            "marks": { "type": "number", "default": "2.5" },
            "comments": { "$ref": "#/definitions/markdown" },
            "feedback": { "$ref": "#/definitions/markdown" },
            "question": { "$ref": "#/definitions/markdown" },
            "figure": { "$ref": "#/definitions/markdown" },
            "figure-split": { "type": "number" },
            "answers": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "required": ["question", "answers"],
          "additionalProperties": false
        }
      },
      {
        "if": { "properties": { "type": { "const": "num" } } },
        "then": {
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string" },
            "title": { "type": "string" },
            "marks": { "type": "number", "default": "2.5" },
            "comments": { "$ref": "#/definitions/markdown" },
            "feedback": { "$ref": "#/definitions/markdown" },
            "question": { "$ref": "#/definitions/markdown" },
            "figure": { "$ref": "#/definitions/markdown" },
            "figure-split": { "type": "number" },
            "answer": { "type": ["number", "string"] },
            "tolerance": { "type": "number" }
          },
          "required": ["question", "answer"],
          "additionalProperties": false
        }
      },
      {
        "if": { "properties": { "type": { "const": "part" } } },
        "then": {
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string" },
            "title": {  "$ref": "#/definitions/markdown" },
            "marks": { "type": "number" },
            "question": { "$ref": "#/definitions/markdown" }
          },
          "additionalProperties": false
        }
      }
    ]
  }
}
