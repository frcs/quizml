<?xml version="1.0" encoding="UTF-8"?>
<manifest identifier="MANIFEST_<< qti.assessment_ident >>"
          xmlns="http://www.imsglobal.org/xsd/imscp_v1p1"
          xmlns:imsmd="http://www.imsglobal.org/xsd/imsmd_v1p2"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.imsglobal.org/xsd/imscp_v1p1 http://www.imsglobal.org/xsd/imscp_v1p1.xsd http://ltsc.ieee.org/xsd/LOM http://www.imsglobal.org/xsd/imsmd_loose_v1p3p2.xsd http://www.imsglobal.org/xsd/imsqti_item_xmlv2p1 http://www.imsglobal.org/xsd/qti/qtiv2p1/imsqti_item_xmlv2p1.xsd">
  <metadata>
    <schema>QTIv2.1 Package</schema>
    <schemaversion>2.1</schemaversion>
    <imsmd:lom>
      <imsmd:general>
        <imsmd:title>
          <imsmd:langstring xml:lang="en"><< qti.title | e >></imsmd:langstring>
        </imsmd:title>
<| if qti.description |>
        <imsmd:description>
          <imsmd:langstring xml:lang="en"><< qti.description | e >></imsmd:langstring>
        </imsmd:description>
<| endif |>
      </imsmd:general>
    </imsmd:lom>
  </metadata>
  <organizations/>
  <resources>
    <resource identifier="assessment_test" type="imsqti_test_xmlv2p1" href="assessment.xml">
      <file href="assessment.xml"/>
<| for q in questions |>
      <dependency identifierref="item_<< loop.index >>"/>
<| endfor |>
    </resource>
<| for q in questions |>
    <resource identifier="item_<< loop.index >>" type="imsqti_item_xmlv2p1" href="items/item_<< loop.index >>.xml">
      <metadata>
        <imsmd:lom>
          <imsmd:general>
            <imsmd:title>
              <imsmd:langstring xml:lang="en"><< q.title | default("Question " ~ loop.index) | e >></imsmd:langstring>
            </imsmd:title>
          </imsmd:general>
        </imsmd:lom>
      </metadata>
      <file href="items/item_<< loop.index >>.xml"/>
    </resource>
<| endfor |>
  </resources>
</manifest>
