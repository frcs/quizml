\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{omrglyphs}[2026/10/31 v2.0 Parametric OMR Glyphs]

\RequirePackage{tikz}
\RequirePackage{graphicx}
\RequirePackage{xspace}
\RequirePackage{iftex}

%% Select TeX Gyre Heros Regular (GUST Font License, standard in TeX Live)
%% or fall back cleanly to the document's medium-weight sans-serif family.
\iftutex
  \RequirePackage{fontspec}
  \IfFontExistsTF{TeX Gyre Heros}{%
    \newfontfamily\omr@font{TeX Gyre Heros}[Scale=1.0,NFSSFamily=omrheros]%
  }{%
    \newcommand{\omr@font}{\sffamily\mdseries\upshape}%
  }%
\else
  \IfFileExists{tgheros.sty}{%
    \RequirePackage{tgheros}%
    \newcommand{\omr@font}{\fontencoding{T1}\fontfamily{qhv}\fontseries{m}\fontshape{n}\selectfont}%
  }{%
    \newcommand{\omr@font}{\sffamily\mdseries\upshape}%
  }%
\fi

%% Internal parametric OMR bubble macro optimized to match omrglyphs v1.0:
%%   Outer diameter D_out = 10bp (scaled to 1em via \resizebox{!}{1em})
%%   Circle midline radius R_mid = 4.747bp (0.4747 * D_out)
%%   Circle stroke width w = 0.506bp (0.0506 * D_out)
%%   Character cap height H_cap = 3.916bp (0.3916 * D_out -> fontsize 5.37bp in TeX Gyre Heros)
\newcommand{\omr@bubble}[2]{%
  {\raisebox{-0.2em}{\resizebox{!}{1em}{%
    \begin{tikzpicture}[baseline=0pt]
      \filldraw[fill=#1, draw=black, line width=0.506bp] (0,0) circle[radius=4.747bp];
      \node[inner sep=0pt, outer sep=0pt, anchor=center, text=black] at (0,-0.05bp) {%
        \omr@font\fontsize{5.37bp}{5.37bp}\selectfont\strut #2%
      };
    \end{tikzpicture}%
  }}}\xspace%
}

%% Open (unchecked) and checked (57% gray pencil shading) bubble macros
\newcommand{\omrN}[1]{\omr@bubble{black!0}{#1}}
\newcommand{\omrC}[1]{\omr@bubble{black!57}{#1}}

%% Backward-compatible helper macros
\newcommand{\OMRGlyphNoCheck}{}
\newcommand{\inlineOMRGlyph}[1]{\omrN{#1}}

%% Define shortcuts for glyphs A-Z (\oA .. \oZ, \xA .. \xZ, \OMRGlyphA .. \OMRGlyphZ)
\foreach \x in {A,...,Z} {
  \expandafter\xdef\csname OMRGlyph\x\endcsname{\x}
  \expandafter\xdef\csname o\x\endcsname{\noexpand\omrN{\x}}
  \expandafter\xdef\csname x\x\endcsname{\noexpand\omrC{\x}}
}

%% Define shortcuts for glyphs 0-9 (\oZero .. \oNine, \xZero .. \xNine, \OMRGlyphZero .. \OMRGlyphNine)
\newcommand{\OMRGlyphZero}{0}  \newcommand{\oZero}{\omrN{0}}  \newcommand{\xZero}{\omrC{0}}
\newcommand{\OMRGlyphOne}{1}   \newcommand{\oOne}{\omrN{1}}   \newcommand{\xOne}{\omrC{1}}
\newcommand{\OMRGlyphTwo}{2}   \newcommand{\oTwo}{\omrN{2}}   \newcommand{\xTwo}{\omrC{2}}
\newcommand{\OMRGlyphThree}{3} \newcommand{\oThree}{\omrN{3}} \newcommand{\xThree}{\omrC{3}}
\newcommand{\OMRGlyphFour}{4}  \newcommand{\oFour}{\omrN{4}}  \newcommand{\xFour}{\omrC{4}}
\newcommand{\OMRGlyphFive}{5}  \newcommand{\oFive}{\omrN{5}}  \newcommand{\xFive}{\omrC{5}}
\newcommand{\OMRGlyphSix}{6}   \newcommand{\oSix}{\omrN{6}}   \newcommand{\xSix}{\omrC{6}}
\newcommand{\OMRGlyphSeven}{7} \newcommand{\oSeven}{\omrN{7}} \newcommand{\xSeven}{\omrC{7}}
\newcommand{\OMRGlyphEight}{8} \newcommand{\oEight}{\omrN{8}} \newcommand{\xEight}{\omrC{8}}
\newcommand{\OMRGlyphNine}{9}  \newcommand{\oNine}{\omrN{9}}  \newcommand{\xNine}{\omrC{9}}

\newcommand{\omrDIGITS}{\oZero\oOne\oTwo\oThree\oFour\oFive\oSix\oSeven\oEight\oNine}
